# ========================================
# OposTest Pro - Configuración
# ========================================
# Copia este archivo como .env y modifica los valores según tu entorno.
# npm run dev establece NODE_ENV=development; npm start establece production.
# No pongas SESSION_SECRET en este ejemplo. npm start exige uno fuerte en producción.

# ----------------------------------------
# BASE DE DATOS (PostgreSQL)
# ----------------------------------------
# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
# Valor de ejemplo para desarrollo local: cambia la contraseña y no lo uses en producción.
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/opostest

# ----------------------------------------
# SERVIDOR
# ----------------------------------------
# Puerto en el que se ejecutará la aplicación (por defecto: 5000)
PORT=5000

# ----------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# ----------------------------------------
# Nombre de la aplicación (se muestra en el título y PWA)
APP_NAME=OposTest Pro

# Descripción corta de la aplicación
APP_DESCRIPTION=Preparación de oposiciones

# Mensaje de bienvenida en la pantalla de carga
WELCOME_MESSAGE=Preparando tu entorno de estudio...

# ----------------------------------------
# SEGURIDAD
# ----------------------------------------
# Clave secreta de sesiones. En producción es obligatoria y se valida al arrancar.
# Genera una clave privada con: openssl rand -base64 48
SESSION_SECRET=

# Saltos de proxy inverso de confianza (0 ignora cabeceras de proxy; usa 1 solo tras un proxy controlado)
TRUST_PROXY_HOPS=0

# Logs de API (método, ruta de plantilla, estado y duración; no incluyen cuerpos ni query strings).
# Usa false para desactivarlos en una instancia privada.
REQUEST_LOGGING_ENABLED=true

# Registro de cuentas: habilitado por defecto en desarrollo y deshabilitado en producción.
# Para permitir altas en producción, configura explícitamente REGISTRATION_ENABLED=true.
REGISTRATION_ENABLED=

# ----------------------------------------
# OPCIONES AVANZADAS (opcional)
# ----------------------------------------
# Origen público exacto de la app (sin barra final); se compara para solicitudes mutables/CSRF.
# Déjalo sin configurar si el navegador accede al mismo origen servido por esta aplicación.
# APP_URL=https://tu-dominio.com
